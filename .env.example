# ---------------------------------------------------------------
# ControllAI-Agent – Konfiguration
# Datei nach .env kopieren und Werte eintragen. .env niemals committen.
# ---------------------------------------------------------------

# LLM-Anbieter: anthropic oder gemini
LLM_PROVIDER=anthropic
# Modellkennung exakt aus der Konsole des Anbieters übernehmen
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 0 = möglichst reproduzierbare Ausgaben; leer lassen, falls das Modell den Parameter nicht unterstützt
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

# Datenbank und SQL-Guardrails
DB_PATH=data/controlling_erp.db
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=5
# Beispielzeilen je Tabelle im Prompt; 0 = keine Datenbankinhalte an das Sprachmodell
SCHEMA_SAMPLE_ROWS=3

# BSC-Klassifikation: Vorschläge unter dieser Konfidenz werden zur manuellen Prüfung markiert
BSC_MIN_CONFIDENCE=0.7

LOG_LEVEL=INFO
